        "jsCode": "// Files that are indexed but no longer in the Drive folder.\nconst drive = new Set($('Collect Drive IDs').first().json.drive_ids);\nif (drive.size === 0) return []; // safety: never delete when Drive returned nothing\nconst indexed = $input.all().map(i => i.json.file_id).filter(Boolean);\nconst orphans = indexed.filter(id => !drive.has(id));\n// safety: if NONE of the indexed files are in this folder, the folder is probably wrong.\nif (indexed.length > 0 && orphans.length === indexed.length) {\n  throw new Error('KB Cleanup stopped: none of the indexed files were found in the Drive folder. Check the folder in List Drive Files. Nothing was deleted.');\n}\nreturn orphans.map(id => ({ json: { file_id: id } }));"
