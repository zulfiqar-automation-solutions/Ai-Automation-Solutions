      "parameters": {
        "jsCode": "// Build the search text and the keyword list. If the rewrite failed, use the question alone.\nconst q = $('Normalize Input').first().json;\nlet rewritten = '';\ntry {\n  rewritten = String($input.first().json.choices[0].message.content || '').trim().slice(0, 200);\n} catch (e) {}\nconst STOP = new Set('a an the of to in on for is are be do does did can i you we my our your how what when who whom which where why many much from with by at as it its this that there and or if not no any get gets so than then into per about me us they them their will would should could may might have has had was were been being also just only'.split(' '));\nconst text = (q.question + ' ' + rewritten).toLowerCase();\nconst words = [...new Set((text.match(/[a-z0-9]+/g) || []).filter(w => w.length > 1 && !STOP.has(w)))];\nreturn [{ json: {\n  question: q.question,\n  session_id: q.session_id,\n  channel: q.channel,\n  search_query: rewritten ? q.question + ' | ' + rewritten : q.question,\n  kw_query: words.slice(0, 14).join(' '),\n} }];\n"
      },
