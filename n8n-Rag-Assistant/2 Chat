      "parameters": {
        "jsCode": "// Merge meaning matches and exact-word matches into one ranked list (Reciprocal Rank Fusion).\nconst input = $('Normalize Input').first().json;\nconst vec = $input.all()\n  .filter(i => i.json && i.json.document && i.json.document.pageContent)\n  .map(i => ({\n    score: Number(i.json.score) || 0,\n    text: i.json.document.pageContent,\n    file: (i.json.document.metadata && i.json.document.metadata.file_name) || 'unknown',\n  }))\n  .sort((a, b) => b.score - a.score);\nlet kw = [];\ntry { kw = $('Pack Keyword Hits').first().json.kw_hits || []; } catch (e) {}\nconst norm = t => String(t).replace(/\\s+/g, ' ').trim().toLowerCase().slice(0, 300);\nconst pool = new Map();\nconst add = (list, field) => list.forEach((r, idx) => {\n  const key = norm(r.text);\n  if (!pool.has(key)) pool.set(key, { text: r.text, file: r.file, rrf: 0, in_vec: false, in_kw: false });\n  const e = pool.get(key);\n  e.rrf += 1 / (60 + idx + 1);\n  e[field] = true;\n});\nadd(vec, 'in_vec');\nadd(kw, 'in_kw');\nconst merged = [...pool.values()].sort((a, b) => b.rrf - a.rrf).slice(0, 8);\nconst top = vec.length ? vec[0].score : 0;\n// Usable when exact words matched, or the meaning search found something at least slightly close.\nconst usable = merged.length > 0 && (kw.length > 0 || top >= 0.10) ? 1 : 0;\nconst context = merged.map((r, n) => `[${n + 1}] (${r.file})\\n${r.text}`).join('\\n\\n');\nreturn [{ json: {\n  question: input.question,\n  channel: input.channel,\n  session_id: input.session_id,\n  top_similarity: top,\n  vector_hits: vec.length,\n  keyword_hits: kw.length,\n  hit_count: merged.length,\n  usable,\n  context,\n} }];\n"
      },
