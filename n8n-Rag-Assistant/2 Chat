    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with terms as (\n  select distinct t from unnest(string_to_array($1::text, ' ')) as t where t <> ''\n),\ndocs as (\n  select content, metadata->>'file_name' as file_name, to_tsvector('english', content) as tv from documents\n),\ntot as (select count(*)::float as total from docs),\ndf as (\n  select t, (select count(*) from docs where docs.tv @@ plainto_tsquery('english', t)) as n from terms\n)\nselect d.content, d.file_name,\n       sum(ln(1 + (tot.total - df.n + 0.5) / (df.n + 0.5))) as rank\nfrom docs d cross join df cross join tot\nwhere df.n > 0 and d.tv @@ plainto_tsquery('english', df.t)\ngroup by d.content, d.file_name\norder by rank desc\nlimit 8;",
        "options": {
          "queryReplacement": "={{ [$json.kw_query] }}"
        }
