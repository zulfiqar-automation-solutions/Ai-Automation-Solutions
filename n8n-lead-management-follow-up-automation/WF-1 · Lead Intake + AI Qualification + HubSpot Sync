    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"budget_score\",\n    \"timeline_score\",\n    \"service_score\",\n    \"message_score\",\n    \"contact_score\",\n    \"reason\",\n    \"intent\",\n    \"reply_subject\",\n    \"reply_body\",\n    \"recommended_action\"\n  ],\n  \"properties\": {\n    \"budget_score\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"maximum\": 30,\n      \"description\": \"Budget fit, 0-30. Anchors: 0=not stated, 10-15=vague/below typical cost, 20-25=stated and reasonable, 30=matches or exceeds typical cost\"\n    },\n    \"timeline_score\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"maximum\": 25,\n      \"description\": \"Urgency, 0-25. Anchors: 0=none/'someday', 8-12=weeks-months out, 18-20=within weeks, 25=ASAP/urgent\"\n    },\n    \"service_score\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"maximum\": 20,\n      \"description\": \"Service match, 0-20. Anchors: 0=unrelated, 10=loosely related, 20=exact match\"\n    },\n    \"message_score\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"maximum\": 15,\n      \"description\": \"Message detail/intent, 0-15. Anchors: 0=vague one-liner, 8=some detail, 15=specific with clear buying intent\"\n    },\n    \"contact_score\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"maximum\": 10,\n      \"description\": \"Contact completeness, 0-10. Anchors: 0=email only, 5=email+one of phone/company, 10=email+phone+company\"\n    },\n    \"reason\": {\n      \"type\": \"string\",\n      \"description\": \"One or two sentences explaining the score, for the sales team\"\n    },\n    \"intent\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"ready_to_buy\",\n        \"comparing_options\",\n        \"early_research\",\n        \"support_request\",\n        \"spam_or_irrelevant\"\n      ],\n      \"description\": \"What this person actually wants\"\n    },\n    \"reply_subject\": {\n      \"type\": \"string\",\n      \"description\": \"Email subject line, under 60 characters\"\n    },\n    \"reply_body\": {\n      \"type\": \"string\",\n      \"description\": \"Plain text email body, 90 words maximum\"\n    },\n    \"recommended_action\": {\n      \"type\": \"string\",\n      \"description\": \"The single next step the sales team should take\"\n    }\n  }\n}"
      },
