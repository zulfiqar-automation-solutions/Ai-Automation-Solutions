    {
      "parameters": {
        "jsCode": "\n// Fan the run out into an ordered job queue. Hygiene always runs before dedup:\n// clean keys produce far fewer false-positive duplicate pairs.\nconst cfg = $input.first().json;\nconst runId = `${$execution.id}-${Date.now().toString(36)}`;\n\nconst objects = [];\nif (cfg.includeContacts)  objects.push('contacts');\nif (cfg.includeCompanies) objects.push('companies');\nif (cfg.includeDeals)     objects.push('deals');\n\nconst jobs = [];\nif (cfg.runHygiene) for (const o of objects) jobs.push({ kind: 'hygiene',  objectType: o });\nif (cfg.runDedup)   for (const o of objects) jobs.push({ kind: 'dedup',    objectType: o });\n\nif (!jobs.length) {\n  throw new Error('Nothing to run: enable runHygiene/runDedup and at least one object type.');\n}\n\nreturn jobs.map((j, i) => ({\n  json: {\n    ...j,\n    runId,\n    jobIndex: i + 1,\n    jobCount: jobs.length,\n    startedAt: new Date().toISOString(),\n    config: cfg,\n  },\n}));\n"
      },
      "id": "ee9e4cbd-0a83-4d25-87a9-a15daf8fb0f8",
      "name": "🧱 Build Job Queue",
