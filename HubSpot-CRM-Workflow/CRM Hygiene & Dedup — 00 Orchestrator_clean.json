    {
      "parameters": {
        "jsCode": "\n// Normalise whatever the sub-workflow returned (or the error it threw) into one\n// summary row per job, so the \"done\" branch of the loop holds the full run log.\nconst job = $('🔁 Run Jobs Sequentially').first().json;\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  out.push({\n    json: {\n      runId: job.runId,\n      kind: job.kind,\n      objectType: job.objectType,\n      ok: !j.error,\n      error: j.error ? String(j.error.message || j.error) : null,\n      summary: j.summary || j,\n      finishedAt: new Date().toISOString(),\n    },\n  });\n}\nif (!out.length) out.push({ json: { runId: job.runId, kind: job.kind,\n  objectType: job.objectType, ok: false, error: 'Sub-workflow returned no items', summary: {} } });\nreturn out;\n"
      },
      "id": "255f34c0-fad2-4f88-bdca-df47e74a7988",
      "name": "📥 Collect Job Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        544
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(i => i.json);\nconst cfg  = $('⚙️ Global Config').first().json;\nconst runId = rows[0]?.runId || 'n/a';\n\nconst num = v => (typeof v === 'number' ? v : 0);\nconst t = { scanned:0, cleaned:0, fieldsFixed:0, flagged:0, pairs:0, autoMerged:0,\n            pendingApproval:0, lowConfidence:0, writeErrors:0, failedJobs:0 };\n\nconst lines = [];\nfor (const r of rows) {\n  const sMap = r.summary || {};\n  if (!r.ok) { t.failedJobs++; lines.push(`• :x: *${r.kind}/${r.objectType}* — ${r.error}`); continue; }\n  t.scanned         += num(sMap.scanned);\n  t.cleaned         += num(sMap.recordsUpdated);\n  t.fieldsFixed     += num(sMap.fieldsChanged);\n  t.flagged         += num(sMap.recordsFlagged);\n  t.pairs           += num(sMap.pairsFound);\n  t.autoMerged      += num(sMap.autoQueued);\n  t.pendingApproval += num(sMap.reviewQueued);\n  t.lowConfidence   += num(sMap.loggedOnly);\n  t.writeErrors     += num(sMap.writeErrors);\n  lines.push(r.kind === 'hygiene'\n    ? `• :broom: *${r.objectType}* — scanned ${num(sMap.scanned)}, cleaned ${num(sMap.recordsUpdated)}, fields fixed ${num(sMap.fieldsChanged)}, flagged ${num(sMap.recordsFlagged)}`\n    : `• :mag: *${r.objectType}* — scanned ${num(sMap.scanned)}, duplicate pairs ${num(sMap.pairsFound)} (auto ${num(sMap.autoQueued)} / review ${num(sMap.reviewQueued)} / log ${num(sMap.loggedOnly)})`);\n}\n\nconst mode = cfg.dryRun ? ':test_tube: *DRY RUN — no HubSpot records were changed*'\n                        : ':white_check_mark: Live mode';\nconst header = t.failedJobs ? ':rotating_light: CRM Hygiene & Dedup — completed with errors'\n                            : ':sparkles: CRM Hygiene & Dedup — run complete';\n\nconst digestText = [\n  `*${header}*`,\n  mode,\n  `Run \\`${runId}\\` · ${rows.length} job(s) · ${new Date().toISOString().replace('T',' ').slice(0,16)} UTC`,\n  '',\n  ...lines,\n  '',\n  `*Totals* — records scanned *${t.scanned}* · records cleaned *${t.cleaned}* · field fixes *${t.fieldsFixed}* · quality flags *${t.flagged}*`,\n  `*Duplicates* — pairs *${t.pairs}* · auto-merge *${t.autoMerged}* · awaiting approval *${t.pendingApproval}* · logged only *${t.lowConfidence}*`,\n  t.writeErrors ? `:warning: ${t.writeErrors} write error(s) — check the execution log.` : '',\n].filter(Boolean).join('\\n');\n\nreturn [{ json: { runId, totals: t, jobs: rows, digestText, hadErrors: t.failedJobs > 0 } }];\n"
      },
